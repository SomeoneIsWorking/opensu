#version 450
#extension GL_GOOGLE_include_directive : require
// A real frame taken in: its pixels copied and its luma written as the pyramid's base.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D source;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D copy;
layout(set = 1, binding = 1, r32f) uniform writeonly image2D luma;
#include "flow_push.glsl"

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) {
        return;
    }
    const vec4 colour = imageLoad(source, p);
    imageStore(copy, p, vec4(colour.rgb, 1.0));
    imageStore(luma, p, vec4(dot(colour.rgb, vec3(0.299, 0.587, 0.114))));
}
