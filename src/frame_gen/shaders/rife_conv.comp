#version 450
#extension GL_GOOGLE_include_directive : require
// A square convolution with zero padding, its bias and an optional leaky ReLU, one output value
// per thread (ncnn's Convolution, weights [out][in][ky][kx]).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rife_buffers.glsl"
layout(push_constant) uniform Push {
    ivec4 src;  // offset, width, height, channels
    ivec4 dst; // offset, width, height, channels
    int weight;   // offset of the weights
    int bias;     // offset of the bias, -1 for none
    int kernel;
    int stride;
    int pad;
    float slope; // the leaky ReLU's for negative values, 1 for none
} push;

void main() {
    const ivec3 p = ivec3(gl_GlobalInvocationID);
    if (p.x >= push.dst.y || p.y >= push.dst.z || p.z >= push.dst.w) {
        return;
    }
    const int k = push.kernel;
    float sum = push.bias >= 0 ? weights[push.bias + p.z] : 0.0;
    for (int i = 0; i < push.src.w; ++i) {
        const int kernelAt = push.weight + (p.z * push.src.w + i) * k * k;
        for (int ky = 0; ky < k; ++ky) {
            const int y = p.y * push.stride + ky - push.pad;
            if (y < 0 || y >= push.src.z) {
                continue;
            }
            for (int kx = 0; kx < k; ++kx) {
                const int x = p.x * push.stride + kx - push.pad;
                if (x >= 0 && x < push.src.y) {
                    sum += blobAt(push.src.x, push.src.y, push.src.z, x, y, i) *
                           weights[kernelAt + ky * k + kx];
                }
            }
        }
    }
    if (sum < 0.0) {
        sum *= push.slope;
    }
    blobs[push.dst.x + (p.z * push.dst.z + p.y) * push.dst.y + p.x] = sum;
}
