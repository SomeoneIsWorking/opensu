#version 450
#extension GL_GOOGLE_include_directive : require
// The graph's output into a frame: each frame pixel takes its content pixel, rounded to 8 bits
// as RIFE's reference rounds.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0) buffer Blobs {
    float blobs[];
};
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D frame;
layout(push_constant) uniform Push {
    ivec4 src;   // offset, padded width, padded height, 3
    ivec2 size;    // the frame's pixels
    ivec2 content; // the content's pixels
    vec2 pixel;    // a content pixel in the frame's
} push;

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (p.x >= push.size.x || p.y >= push.size.y) {
        return;
    }
    const ivec2 c = min(ivec2(vec2(p) / push.pixel), push.content - 1);
    const int plane = push.src.y * push.src.z;
    const int at = push.src.x + c.y * push.src.y + c.x;
    const vec3 colour = vec3(blobs[at], blobs[at + plane], blobs[at + 2 * plane]);
    imageStore(frame, p, vec4(clamp(floor(colour * 255.0 + 0.5), 0.0, 255.0) / 255.0, 1.0));
}
