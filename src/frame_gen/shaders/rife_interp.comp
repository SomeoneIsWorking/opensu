#version 450
#extension GL_GOOGLE_include_directive : require
// A bilinear resize by a scale, half-pixel centres, clamped at the edges as ncnn's Interp.
layout(local_size_x = 8, local_size_y = 8) in;
#include "rife_buffers.glsl"
layout(push_constant) uniform Push {
    ivec4 src;  // offset, width, height, channels
    ivec4 dst; // offset, width, height, channels
    vec2 scale;   // input pixels per output pixel
} push;

// The source index and the next one's weight for output `d` of a side of `size`.
void linear(int d, int size, float scale, out int s, out float f) {
    const float at = (float(d) + 0.5) * scale - 0.5;
    s = int(floor(at));
    f = at - float(s);
    if (s < 0) {
        s = 0;
        f = 0.0;
    }
    if (s >= size - 1) {
        s = size - 2;
        f = 1.0;
    }
}

void main() {
    const ivec3 p = ivec3(gl_GlobalInvocationID);
    if (p.x >= push.dst.y || p.y >= push.dst.z || p.z >= push.dst.w) {
        return;
    }
    int sx;
    int sy;
    float fx;
    float fy;
    linear(p.x, push.src.y, push.scale.x, sx, fx);
    linear(p.y, push.src.z, push.scale.y, sy, fy);
    const int o = push.src.x;
    const int w = push.src.y;
    const int h = push.src.z;
    const float top = blobAt(o, w, h, sx, sy, p.z) * (1.0 - fx) + blobAt(o, w, h, sx + 1, sy, p.z) * fx;
    const float bottom =
        blobAt(o, w, h, sx, sy + 1, p.z) * (1.0 - fx) + blobAt(o, w, h, sx + 1, sy + 1, p.z) * fx;
    blobs[push.dst.x + (p.z * push.dst.z + p.y) * push.dst.y + p.x] =
        top * (1.0 - fy) + bottom * fy;
}
