#version 450
// A frame scaled up nearest by a whole factor.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D source;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D scaled;
layout(push_constant) uniform Push {
    int scale;
} push;

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(scaled)))) {
        return;
    }
    imageStore(scaled, p, imageLoad(source, p / push.scale));
}
