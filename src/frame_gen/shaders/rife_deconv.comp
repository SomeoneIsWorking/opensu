#version 450
#extension GL_GOOGLE_include_directive : require
// A square transposed convolution with its bias, the padding cut from every side, gathered one
// output value per thread (ncnn's Deconvolution, weights [out][in][ky][kx]).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rife_buffers.glsl"
layout(push_constant) uniform Push {
    ivec4 src;  // offset, width, height, channels
    ivec4 dst; // offset, width, height, channels
    int weight;
    int bias; // -1 for none
    int kernel;
    int stride;
    int pad;
} push;

void main() {
    const ivec3 p = ivec3(gl_GlobalInvocationID);
    if (p.x >= push.dst.y || p.y >= push.dst.z || p.z >= push.dst.w) {
        return;
    }
    const int k = push.kernel;
    const int s = push.stride;
    float sum = push.bias >= 0 ? weights[push.bias + p.z] : 0.0;
    for (int ky = 0; ky < k; ++ky) {
        const int by = p.y + push.pad - ky;
        if (by < 0 || by % s != 0 || by / s >= push.src.z) {
            continue;
        }
        for (int kx = 0; kx < k; ++kx) {
            const int bx = p.x + push.pad - kx;
            if (bx < 0 || bx % s != 0 || bx / s >= push.src.y) {
                continue;
            }
            for (int i = 0; i < push.src.w; ++i) {
                sum += blobAt(push.src.x, push.src.y, push.src.z, bx / s, by / s, i) *
                       weights[push.weight + ((p.z * push.src.w + i) * k + ky) * k + kx];
            }
        }
    }
    blobs[push.dst.x + (p.z * push.dst.z + p.y) * push.dst.y + p.x] = sum;
}
