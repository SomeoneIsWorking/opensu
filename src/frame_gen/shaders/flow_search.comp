#version 450
#extension GL_GOOGLE_include_directive : require
#extension GL_EXT_control_flow_attributes : require
// One level's motion field, from the earlier real frame to the later, one vector per block of the
// frame between them: the block's pixels matched at t 0.5 (`earlierShare` in the level's pixels)
// by the sum of absolute luma differences over the block and a 2 pixel margin, less their mean.
// The coarsest level tries every vector within `range`; each finer one its parent's 3 x 3
// neighbourhood's vectors, doubled, and then every vector within 2 pixels of the best. A block
// either frame is flat over (a fade from white) shows no motion, so it keeps none. Of equal costs
// the earlier candidate wins, the zero vector before all.
// One workgroup per block, its `threads` trying the candidates side by side (64 at the coarsest
// level's 289, 32 at the finer levels' 9 and 25). The windows a set of
// candidates reads in each frame are loaded once into shared memory; the parent's candidates, which
// lie anywhere, are read from the frames, and beside them the zero vector's cost and the flat
// tests, so the threads take one path. A candidate already tried, or the zero vector, is not
// costed again. The loops over a window are unrolled so its reads go out together; each sum keeps
// its order.
layout(local_size_x_id = 1) in;
layout(constant_id = 1) const uint threads = 64;
layout(set = 0, binding = 0, r32f) uniform readonly image2D earlier;
layout(set = 0, binding = 1, r32f) uniform readonly image2D later;
layout(set = 0, binding = 2, rg32f) uniform readonly image2D parent;
layout(set = 0, binding = 3, rg32f) uniform writeonly image2D field;
#include "flow_push.glsl"

const int margin = 2;
// Per pixel and pixel of vector length: between equal matches the shorter vector wins.
const float lengthCost = 1.0 / 4096.0;

// Mean absolute deviation of luma per pixel below which a window counts as flat.
const float flatBelow = 1.0 / 255.0;

const int side = blockSize + 2 * margin;
// How far past the block's window the tiles reach: the coarsest range's vectors move each frame's
// by up to 4 pixels either way, the finer levels' within 2 of the centre by up to 1 (`tileReach`
// in flow_interpolator.cpp).
layout(constant_id = 2) const int tileReach = 4;
const int tileSide = side + 2 * tileReach;
shared float earlierTile[tileSide * tileSide];
shared float laterTile[tileSide * tileSide];
// Each tile's top left pixel in its frame.
ivec2 earlierCorner;
ivec2 laterCorner;

// Loads the pixels every vector from `low` to `high` reads around `origin` in both frames.
void loadTiles(ivec2 origin, ivec2 low, ivec2 high) {
    const ivec2 last = push.size - 1;
    earlierCorner = origin - margin - earlierShare(vec2(high), 0.5);
    laterCorner = origin - margin + low - earlierShare(vec2(low), 0.5);
    const ivec2 earlierSize = ivec2(side) + earlierShare(vec2(high), 0.5) -
                              earlierShare(vec2(low), 0.5);
    const ivec2 laterSize = ivec2(side) + (high - earlierShare(vec2(high), 0.5)) -
                            (low - earlierShare(vec2(low), 0.5));
    for (int k = int(gl_LocalInvocationIndex); k < tileSide * tileSide; k += int(threads)) {
        const ivec2 q = ivec2(k % tileSide, k / tileSide);
        if (all(lessThan(q, earlierSize))) {
            earlierTile[k] = READ(earlier, clamp(earlierCorner + q, ivec2(0), last)).r;
        }
        if (all(lessThan(q, laterSize))) {
            laterTile[k] = READ(later, clamp(laterCorner + q, ivec2(0), last)).r;
        }
    }
    barrier();
}

float earlierAt(ivec2 p) {
    const ivec2 q = p - earlierCorner;
    return SHARED(earlierTile[q.y * tileSide + q.x]);
}

float laterAt(ivec2 p) {
    const ivec2 q = p - laterCorner;
    return SHARED(laterTile[q.y * tileSide + q.x]);
}

// A frame's luma at `p`, from its tile, which must hold it, or from the frame.
float lumaAt(ivec2 p, bool isLater, bool tiled) {
    if (tiled) {
        return isLater ? laterAt(p) : earlierAt(p);
    }
    const ivec2 q = clamp(p, ivec2(0), push.size - 1);
    return isLater ? READ(later, q).r : READ(earlier, q).r;
}

// The cost of `d`, from the tiles, which must hold its windows, or from the frames. With one
// frame's luma taken as 0 it is the other's deviation from its mean over the block's window
// (`isFlat`).
float cost(ivec2 origin, ivec2 d, bool tiled, bool withEarlier, bool withLater) {
    const ivec2 back = earlierShare(vec2(d), 0.5);
    const ivec2 ahead = d - back;
    float differences[side * side];
    float mean = 0.0;
    [[unroll]] for (int y = 0; y < side; ++y) {
        [[unroll]] for (int x = 0; x < side; ++x) {
            const ivec2 p = origin + ivec2(x - margin, y - margin);
            const float e = lumaAt(p - back, false, tiled);
            const float l = lumaAt(p + ahead, true, tiled);
            const float difference = (withEarlier ? e : 0.0) - (withLater ? l : 0.0);
            differences[y * side + x] = difference;
            mean += difference;
        }
    }
    mean /= float(side * side);
    // The block's mean difference left out, so a fade or a flash moves nothing.
    float sum = 0.0;
    [[unroll]] for (int i = 0; i < side * side; ++i) {
        sum += abs(differences[i] - mean);
    }
    return sum + lengthCost * float(side * side) * float(abs(d.x) + abs(d.y));
}

// Whether a frame whose deviation over the block's window is `deviation` is flat there.
bool isFlat(float deviation) {
    return deviation < flatBelow * float(side * side);
}

shared float bestCosts[threads];
shared int bestIndices[threads];
shared float zeroCost;
shared bool earlierFlat;
shared bool laterFlat;
shared ivec2 parentVectors[9];

// Whether `d` is the zero vector or one of the first `count` parent candidates, whose costs are
// already in the best one's.
bool tried(ivec2 d, int count) {
    bool found = all(equal(d, ivec2(0)));
    for (int j = 0; j < count && !found; ++j) {
        found = all(equal(SHARED(parentVectors[j]), d));
    }
    return found;
}

// Of each thread's (cost, index), the lowest cost, the lower index of equal ones.
int lowest(float c, int index) {
    const uint i = gl_LocalInvocationIndex;
    bestCosts[i] = c;
    bestIndices[i] = index;
    barrier();
    for (uint stride = threads / 2; stride > 0; stride /= 2) {
        if (i < stride) {
            const float other = bestCosts[i + stride];
            const int otherIndex = bestIndices[i + stride];
            if (other < bestCosts[i] || (other == bestCosts[i] && otherIndex < bestIndices[i])) {
                bestCosts[i] = other;
                bestIndices[i] = otherIndex;
            }
        }
        barrier();
    }
    return bestIndices[0];
}

// Keeps the zero vector's cost (`which` 0) or a frame's flat test (1 the earlier's, 2 the later's).
void keepZeroOrFlat(int which, float c) {
    if (which == 0) {
        zeroCost = c;
    } else if (which == 1) {
        earlierFlat = isFlat(c);
    } else {
        laterFlat = isFlat(c);
    }
}

// Writes no motion for a block either frame is flat over.
bool keptStill(ivec2 block) {
    if (earlierFlat || laterFlat) {
        if (gl_LocalInvocationIndex == 0) {
            imageStore(field, block, vec4(0.0));
        }
        return true;
    }
    return false;
}

void main() {
    const ivec2 block = ivec2(gl_WorkGroupID.xy);
    const ivec2 origin = block * blockSize;
    const int i = int(gl_LocalInvocationIndex);
    ivec2 best = ivec2(0);
    const float none = 1.0 / 0.0;
    if (push.hasParent == 0) {
        loadTiles(origin, -ivec2(push.range), ivec2(push.range));
        if (i < 3) {
            keepZeroOrFlat(i, cost(origin, ivec2(0), true, i != 2, i != 1));
        }
        barrier();
        if (keptStill(block)) {
            return;
        }
        const int side = 2 * push.range + 1;
        float mine = none;
        int mineIndex = side * side;
        for (int k = i; k < side * side; k += int(threads)) {
            const float c = cost(origin, ivec2(k % side - push.range, k / side - push.range), true,
                                 true, true);
            if (c < mine) {
                mine = c;
                mineIndex = k;
            }
        }
        const int k = lowest(mine, mineIndex);
        if (bestCosts[0] < zeroCost) {
            best = ivec2(k % side - push.range, k / side - push.range);
        }
    } else {
        const ivec2 parentLast = imageSize(parent) - 1;
        if (i < 9) {
            const ivec2 at = clamp(block / 2 + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), parentLast);
            parentVectors[i] = ivec2(READ(parent, at).rg) * 2;
        }
        barrier();
        // The parents' candidates on threads 0 to 8, the zero vector and the flat tests on 9 to 11.
        // A candidate equal to an earlier one or to the zero vector cannot win: of equal costs the
        // earlier is kept.
        // One cost for all of them, so the threads take one path.
        float mine = none;
        if (i < 12) {
            const ivec2 d = i < 9 ? SHARED(parentVectors[i]) : ivec2(0);
            if (i >= 9 || !tried(d, i)) {
                const float c = cost(origin, d, false, i != 11, i != 10);
                if (i < 9) {
                    mine = c;
                } else {
                    keepZeroOrFlat(i - 9, c);
                }
            }
        }
        const int k = lowest(mine, i < 9 ? i : 9);
        if (keptStill(block)) {
            return;
        }
        float bestCost = zeroCost;
        if (bestCosts[0] < bestCost) {
            best = SHARED(parentVectors[k]);
            bestCost = bestCosts[0];
        }
        barrier();
        const ivec2 centre = best;
        loadTiles(origin, centre - 2, centre + 2);
        mine = none;
        if (i < 25) {
            const ivec2 d = centre + ivec2(i % 5 - 2, i / 5 - 2);
            if (!tried(d, 9)) {
                mine = cost(origin, d, true, true, true);
            }
        }
        const int n = lowest(mine, i < 25 ? i : 25);
        if (bestCosts[0] < bestCost) {
            best = centre + ivec2(n % 5 - 2, n / 5 - 2);
            bestCost = bestCosts[0];
        }
    }
    if (i == 0) {
        imageStore(field, block, vec4(vec2(best), 0.0, 0.0));
    }
}
