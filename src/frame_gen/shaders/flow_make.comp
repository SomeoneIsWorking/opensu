#version 450
#extension GL_GOOGLE_include_directive : require
// The frame at time t between two real ones: the two mixed by t at each pixel's chosen motion,
// split in the content's whole pixels (`earlierShare`).
// Untaken real pixels (no chosen motion took them) are shown lit as the frame between is: a shape
// of them in the nearer frame where it is and whole, so a shape no vector fits does not vanish or
// break up. Elsewhere a pixel that matched badly is one frame's alone, uncovered or about to be
// covered: of its own and 8 neighbouring choices `reach` pixels away, the vector landing on the
// most untaken pixels of one frame gives it from that frame. Specks both frames have (rain) left
// over come from each weighted by time.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D earlier;
layout(set = 0, binding = 1, rgba8) uniform readonly image2D later;
layout(set = 0, binding = 2, rgba16f) uniform readonly image2D choice;
layout(set = 0, binding = 3, r32ui) uniform readonly uimage2D used;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D made;
#include "flow_push.glsl"

// Of a pixel's 5 x 5, how many must be untaken for it to be part of a shape rather than a speck.
const int shapeAt = 18;
// The 3 x 3 disagreement (summed over channels) above which a pixel is looked for in one frame.
const float trusted = 1.0;
const int reach = 4;
// Untaken pixels of a 3 x 3 a one-frame source needs.
const int oneFrameAt = 5;

int untaken(ivec2 q, uint mark) {
    const ivec2 last = push.size - 1;
    int count = 0;
    for (int i = 0; i < 9; ++i) {
        const ivec2 r = clamp(q + ivec2(i % 3 - 1, i / 3 - 1), ivec2(0), last);
        count += (imageLoad(used, r).r & mark) == 0u ? 1 : 0;
    }
    return count;
}

vec3 at(ivec2 p, bool isLater) {
    const ivec2 q = clamp(p, ivec2(0), push.size - 1);
    return isLater ? imageLoad(later, q).rgb : imageLoad(earlier, q).rgb;
}

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, push.size))) {
        return;
    }
    const ivec2 last = push.size - 1;
    const vec4 chosen = imageLoad(choice, p);
    const vec2 d = chosen.rg;
    const float disagreement = chosen.b;
    const uint here = imageLoad(used, p).r;
    int lostEarlier = 0;
    int lostLater = 0;
    for (int y = -2; y <= 2; ++y) {
        for (int x = -2; x <= 2; ++x) {
            const uint u = imageLoad(used, clamp(p + ivec2(x, y), ivec2(0), last)).r;
            lostEarlier += (u & 1u) == 0u ? 1 : 0;
            lostLater += (u & 2u) == 0u ? 1 : 0;
        }
    }
    const bool earlierLost = (here & 1u) == 0u;
    const bool laterLost = (here & 2u) == 0u;
    const bool earlierShape = earlierLost && lostEarlier >= shapeAt;
    const bool laterShape = laterLost && lostLater >= shapeAt;
    const float toLater = (1.0 - push.t) * chosen.a;
    const float fromEarlier = push.t * chosen.a;
    const vec3 earlierLit = clamp(at(p, false) + fromEarlier, 0.0, 1.0);
    const vec3 laterLit = clamp(at(p, true) - toLater, 0.0, 1.0);
    const bool nearerIsLater = push.t > 0.5;
    const ivec2 back = earlierShare(d, push.t);
    vec3 colour = mix(at(p - back, false), at(p + ivec2(d) - back, true), push.t);
    const bool hold = nearerIsLater ? laterShape : earlierShape;
    int oneFrame = oneFrameAt - 1;
    if (!hold && disagreement > trusted) {
        for (int n = 0; n < 9; ++n) {
            // Its own first, then the nearer frame, which keep ties.
            const ivec2 offset = ivec2((n % 3 + 1) % 3 - 1, (n / 3 + 1) % 3 - 1) * reach;
            const vec2 other = imageLoad(choice, clamp(p + offset, ivec2(0), last)).rg;
            const ivec2 otherBack = earlierShare(other, push.t);
            const ivec2 fromE = p - otherBack;
            const ivec2 fromL = p + ivec2(other) - otherBack;
            const int countE = untaken(fromE, 1u);
            const int countL = untaken(fromL, 2u);
            const bool laterFirst = nearerIsLater;
            if ((laterFirst ? countL : countE) > oneFrame) {
                oneFrame = laterFirst ? countL : countE;
                colour = laterFirst ? clamp(at(fromL, true) - toLater, 0.0, 1.0)
                                    : clamp(at(fromE, false) + fromEarlier, 0.0, 1.0);
            }
            if ((laterFirst ? countE : countL) > oneFrame) {
                oneFrame = laterFirst ? countE : countL;
                colour = laterFirst ? clamp(at(fromE, false) + fromEarlier, 0.0, 1.0)
                                    : clamp(at(fromL, true) - toLater, 0.0, 1.0);
            }
        }
    }
    const bool fromOneFrame = oneFrame >= oneFrameAt;
    if (hold) {
        colour = nearerIsLater ? laterLit : earlierLit;
    } else if (!fromOneFrame && lostEarlier > 0 && lostLater > 0) {
        if (earlierLost && !earlierShape) {
            colour = mix(colour, earlierLit, 1.0 - push.t);
        }
        if (laterLost && !laterShape) {
            colour = mix(colour, laterLit, push.t);
        }
    }
    imageStore(made, p, vec4(colour, 1.0));
}
