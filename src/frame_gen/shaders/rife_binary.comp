#version 450
#extension GL_GOOGLE_include_directive : require
// An elementwise operation of two blobs broadcast over their sides of 1, or of a blob and a
// scalar (ncnn's BinaryOp; Eltwise's weighted sum as `add` with the weights).
layout(local_size_x = 8, local_size_y = 8) in;
#include "rife_buffers.glsl"
layout(push_constant) uniform Push {
    ivec4 a;      // offset, width, height, channels
    ivec4 b;      // offset (-1 for the scalar), width, height, channels
    ivec4 dst; // offset, width, height, channels
    int op;       // 0 add, 1 sub, 2 mul, 3 div, 7 b - a, 8 b / a
    float scalar;
    float aWeight;
    float bWeight;
} push;

float valueOf(ivec4 blob, ivec3 p) {
    return blobAt(blob.x, blob.y, blob.z, blob.y == 1 ? 0 : p.x, blob.z == 1 ? 0 : p.y,
                  blob.w == 1 ? 0 : p.z);
}

void main() {
    const ivec3 p = ivec3(gl_GlobalInvocationID);
    if (p.x >= push.dst.y || p.y >= push.dst.z || p.z >= push.dst.w) {
        return;
    }
    const float a = valueOf(push.a, p) * push.aWeight;
    const float b = (push.b.x < 0 ? push.scalar : valueOf(push.b, p)) * push.bWeight;
    float v;
    switch (push.op) {
    case 0:
        v = a + b;
        break;
    case 1:
        v = a - b;
        break;
    case 2:
        v = a * b;
        break;
    case 3:
        v = a / b;
        break;
    case 7:
        v = b - a;
        break;
    default:
        v = b / a;
        break;
    }
    blobs[push.dst.x + (p.z * push.dst.z + p.y) * push.dst.y + p.x] = v;
}
