#version 450
// A scaled-up frame brought back, each pixel taken at the centre of its scaled block.
layout(local_size_x = 8, local_size_y = 8) in;
layout(set = 0, binding = 0, rgba8) uniform readonly image2D scaled;
layout(set = 1, binding = 0, rgba8) uniform writeonly image2D frame;
layout(push_constant) uniform Push {
    int scale;
} push;

void main() {
    const ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(p, imageSize(frame)))) {
        return;
    }
    imageStore(frame, p, imageLoad(scaled, p * push.scale + push.scale / 2));
}
