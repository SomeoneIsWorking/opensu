{
  "manifest_version": 3,
  "name": "iideck sign-in",
  "version": "1.0.0",
  "description": "Hands the code a GOG or Epic sign-in ends on to iideck, then closes the tab.",
  "permissions": ["webNavigation", "webRequest", "webRequestBlocking"],
  "host_permissions": [
    "http://127.0.0.1/*",
    "https://embed.gog.com/on_login_success*",
    "https://www.epicgames.com/id/api/redirect*"
  ],
  "background": {
    "scripts": ["background.js"]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "iideck-signin@iideck",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  }
}
