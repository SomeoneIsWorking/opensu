# The CI build environment (tools/check `ci`): the Fedora release the Gamescope fork's podman build
# uses, with openSU's and the fork's build dependencies, and systemd, which runs as PID 1 so the
# tests get the user manager their scopes need. lavapipe (mesa-vulkan-drivers) and the validation
# layers let opensu-retro's tests draw with Vulkan on the display CI forwards in.
# Fedora's SDL3_image opens libpng, libjpeg-turbo and libwebp at run time, so they are named here.
FROM registry.fedoraproject.org/fedora:44@sha256:959833699a2fb5da1bc70b4db659ab229252c2ba1ed8e2fa29d4b30a704c0f63

RUN dnf -y install --setopt=install_weak_deps=False \
        systemd systemd-pam dbus sudo git clang clang-tools-extra cmake ninja-build meson glslang uv cargo \
        dnf-plugins-core libcurl-devel openssl-devel zlib-ng-compat-devel libwebp-devel nanosvg-devel json-devel \
        libX11-devel libXi-devel sqlite-devel \
        SDL3-devel SDL3_ttf-devel harfbuzz-devel SDL3_image-devel libvorbis-devel libjpeg-turbo \
        vulkan-loader-devel libpng-devel glslc mesa-vulkan-drivers vulkan-validation-layers \
    && dnf -y builddep gamescope \
    && dnf clean all

CMD ["/sbin/init"]
