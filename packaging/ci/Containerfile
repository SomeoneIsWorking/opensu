# The Linux build image (tools/check): Fedora with openSU's and the fork's build dependencies, and
# systemd, which runs as PID 1 in CI so the tests get the user manager their scopes need. CI builds
# it on the pinned Fedora 44; a maintainer's build passes BASE for the host's own Fedora release,
# so the binaries link against libraries the host has. lavapipe (mesa-vulkan-drivers) and the
# validation layers let opensu-retro's tests draw with Vulkan on the display CI forwards in.
# Fedora's SDL3_image opens libpng, libjpeg-turbo and libwebp at run time, so they are named here.
# The SDL fork, SDL_ttf and SDL_image are built with Fedora's build dependencies for each, so they
# have the backends Fedora's have.
# iproute gives the ZeroTier meeting test the dummy interface its private network namespace binds.
ARG BASE=registry.fedoraproject.org/fedora:44@sha256:959833699a2fb5da1bc70b4db659ab229252c2ba1ed8e2fa29d4b30a704c0f63
FROM ${BASE}

RUN dnf -y install --setopt=install_weak_deps=False \
        systemd systemd-pam dbus sudo iproute git clang clang-tools-extra cmake ninja-build meson glslang uv cargo \
        dnf-plugins-core libcurl-devel openssl-devel zlib-ng-compat-devel libwebp-devel nanosvg-devel json-devel \
        libX11-devel libXi-devel libXtst-devel pipewire-devel opus-devel sqlite-devel systemd-devel \
        libavcodec-free-devel libavutil-free-devel libva-devel \
        libsecret-devel SDL3-devel SDL3_ttf-devel harfbuzz-devel SDL3_image-devel libvorbis-devel \
        libjpeg-turbo vulkan-loader-devel libpng-devel glslc mesa-vulkan-drivers vulkan-validation-layers \
    && dnf -y builddep gamescope SDL3 SDL3_ttf SDL3_image \
    && dnf clean all

CMD ["/sbin/init"]
